{
  "_readme": [
    "这是配置模板，不含任何真实密钥。",
    "用法一：复制为 config.json，再把自己的 api_key 填进去。",
    "用法二（推荐）：不要改 config.json，直接设置环境变量，程序会自动覆盖对应字段：",
    "  Windows PowerShell:  $env:DEEPSEEK_API_KEY = 'sk-你的密钥'",
    "  永久生效:            setx DEEPSEEK_API_KEY \"sk-你的密钥\"",
    "支持的变量：DEEPSEEK_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY / DASHSCOPE_API_KEY /",
    "  ZHIPU_API_KEY / MOONSHOT_API_KEY / SILICONFLOW_API_KEY / QIANFAN_API_KEY / QIANFAN_SECRET_KEY",
    "切勿把填写了真实密钥的 config.json 提交到 Git 仓库。"
  ],
  "app": {
    "name": "大学生期末复习 AI 答疑助手",
    "team": "第二组：李明轩　韩武晋　郑志",
    "version": "1.3.0",
    "data_dir": "data",
    "log_dir": "data/logs",
    "max_history_turns": 8
  },
  "llm": {
    "default": "deepseek",
    "fallback_to_mock": true,
    "models": {
      "mock": { "model": "mock-offline", "timeout": 60 },
      "deepseek": {
        "model": "deepseek-flash",
        "base_url": "https://api.deepseek.com/v1",
        "api_key": "sk-在此填写你的 DeepSeek API Key",
        "timeout": 180,
        "vision": true
      },
      "openai": { "model": "gpt-4o", "base_url": "https://api.openai.com/v1", "api_key": "", "timeout": 90, "vision": true },
      "anthropic": { "model": "claude-3-5-sonnet-latest", "base_url": "https://api.anthropic.com/v1", "api_key": "", "timeout": 90, "vision": true },
      "dashscope": { "model": "qwen-plus", "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1", "api_key": "", "timeout": 90 },
      "zhipu": { "model": "glm-4-plus", "base_url": "https://open.bigmodel.cn/api/paas/v4", "api_key": "", "timeout": 90 },
      "moonshot": { "model": "moonshot-v1-8k", "base_url": "https://api.moonshot.cn/v1", "api_key": "", "timeout": 90 },
      "siliconflow": { "model": "Qwen/Qwen2.5-7B-Instruct", "base_url": "https://api.siliconflow.cn/v1", "api_key": "", "timeout": 90 },
      "qianfan": { "model": "ernie-4.0-8k", "api_key": "", "secret_key": "", "timeout": 90 },
      "ollama": { "model": "qwen2.5:7b", "base_url": "http://localhost:11434/v1", "api_key": "", "timeout": 180 }
    }
  },
  "image": {
    "enabled": true,
    "max_images": 4,
    "max_bytes": 8388608,
    "allowed_types": ["png", "jpg", "jpeg", "webp", "gif"],
    "detail": "auto"
  },
  "web": { "host": "127.0.0.1", "port": 8848 },
  "risk": {
    "pass_criteria": { "hallucination_rate": 0.2, "logic_errors": 1, "repetition": 0.3 },
    "repetition_rounds": 3,
    "comparison_models": ["deepseek", "openai", "anthropic", "qianfan"]
  }
}
